<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Telar's apps/ios/ExportOptions.plist, measured there: destination
	     `export` plus a separate altool upload, NOT `upload`, because
	     `upload` shipped the archive's development-signed binary and Apple
	     refused it (90035). The export is where the re-sign to Apple
	     Distribution happens. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>export</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>teamID</key>
	<string>MM74W7WGAM</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>uploadSymbols</key>
	<true/>
	<!-- TestFlight internal testing only: the build never goes to review. -->
	<key>testFlightInternalTestingOnly</key>
	<true/>
</dict>
</plist>
